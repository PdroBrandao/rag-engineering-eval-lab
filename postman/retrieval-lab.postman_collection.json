{
  "info": {
    "name": "Retrieval Lab",
    "description": "Local API examples. Set base_url and access_token. Do not store production secrets in the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Ingest PDF",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Choose a PDF on your machine."
            },
            {
              "key": "collection",
              "value": "legacy",
              "type": "text"
            },
            {
              "key": "chunk_size",
              "value": "500",
              "type": "text"
            },
            {
              "key": "chunk_overlap",
              "value": "50",
              "type": "text"
            },
            {
              "key": "replace",
              "value": "false",
              "type": "text"
            }
          ]
        },
        "url": "{{base_url}}/ingest"
      }
    },
    {
      "name": "Query",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question\": \"What are the main risks of LLM-as-a-Judge?\",\n  \"top_k\": 5,\n  \"collections\": [\"legacy\"]\n}"
        },
        "url": "{{base_url}}/query"
      }
    }
  ]
}
